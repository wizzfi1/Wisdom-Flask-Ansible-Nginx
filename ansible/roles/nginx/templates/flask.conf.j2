# Redirect all HTTP to HTTPS
server {
    listen 80;
    server_name wizfi-devops.duckdns.org;

    location / {
        return 301 https://$host$request_uri;
    }
}

# SSL server block
server {
    listen 443 ssl;
    server_name wizfi-devops.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/wizfi-devops.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wizfi-devops.duckdns.org/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://localhost:3000;  # Or 5000 for Flask
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
