- name: Upload Node Exporter dashboard to Grafana
  uri:
    url: "https://{{ grafana_domain }}/api/dashboards/db"
    method: POST
    user: admin
    password: "{{ grafana_admin_password }}"
    force_basic_auth: yes
    headers:
      Content-Type: "application/json"
    body_format: json
    body: "{{ lookup('file', 'files/node-exporter-dashboard.json') | from_json | to_json }}"
    status_code: 200
    validate_certs: no  